generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  engineType          = "client"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  // Preserve the old column without exposing the obsolete singleton model.
  legacySingleton Boolean     @default(true) @map("singleton") @ignore
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  credential      Credential?
  accounts        Account[]
  incomeSources   IncomeSource[]
  commitments     CommitmentSource[]
  financialEvents FinancialEvent[]
  monthlyPlans    MonthlyPlan[]
  financings      Financing[]
  investments     Investment[]

  @@map("users")
}

model Credential {
  userId       String    @id @map("user_id") @db.Uuid
  email        String    @unique @db.VarChar(254)
  displayName  String    @map("display_name") @db.VarChar(80)
  passwordHash String    @map("password_hash")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@map("credentials")
}

model Session {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash") @db.Char(64)
  csrfToken         String     @map("csrf_token") @db.VarChar(43)
  credentialVersion Int        @map("credential_version")
  createdAt         DateTime   @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime   @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime   @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  credential        Credential @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  name              String @db.VarChar(120)
  institution       String? @db.VarChar(120)
  reference         String? @db.VarChar(120)
  currency          String @default("EUR") @db.Char(3)
  archivedFromMonth String? @map("archived_from_month") @db.Char(7)
  version           Int @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaces            Space[]
  incomeRevisions   IncomeRevision[] @relation("IncomeAccount")
  commitmentRevisions CommitmentRevision[] @relation("CommitmentAccount")
  @@unique([id, userId])
  @@index([userId, name, id])
  @@map("accounts")
}

model Space {
  id                String @id @default(uuid()) @db.Uuid
  accountId         String @map("account_id") @db.Uuid
  userId            String @map("user_id") @db.Uuid
  name              String @db.VarChar(120)
  archivedFromMonth String? @map("archived_from_month") @db.Char(7)
  version           Int @default(1)
  account           Account @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  incomeRevisions   IncomeRevision[] @relation("IncomeSpace")
  commitmentRevisions CommitmentRevision[] @relation("CommitmentSpace")
  @@unique([id, accountId, userId])
  @@index([userId, accountId, name, id])
  @@map("spaces")
}

model IncomeSource {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  recurrence        String @db.VarChar(12)
  oneOffMonth       String? @map("one_off_month") @db.Char(7)
  archivedFromMonth String? @map("archived_from_month") @db.Char(7)
  version           Int @default(1)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions         IncomeRevision[]
  @@unique([id, userId])
  @@index([userId, recurrence, id])
  @@map("income_sources")
}

model IncomeRevision {
  id                String @id @default(uuid()) @db.Uuid
  sourceId          String @map("source_id") @db.Uuid
  userId            String @map("user_id") @db.Uuid
  version           Int
  name              String @db.VarChar(120)
  effectiveFromMonth String @map("effective_from_month") @db.Char(7)
  startsOn          DateTime @map("starts_on") @db.Date
  endsOn            DateTime? @map("ends_on") @db.Date
  accountId         String @map("account_id") @db.Uuid
  spaceId           String? @map("space_id") @db.Uuid
  input             Json
  baseCents         BigInt @map("base_cents")
  vatCents          BigInt @map("vat_cents")
  withholdingCents  BigInt @map("withholding_cents")
  commissionCents   BigInt @map("commission_cents")
  cashCents         BigInt @map("cash_cents")
  reserveCents      BigInt @map("reserve_cents")
  spendableCents    BigInt @map("spendable_cents")
  vatRate           Decimal @map("vat_rate") @db.Decimal(9, 8)
  withholdingRate   Decimal @map("withholding_rate") @db.Decimal(9, 8)
  commissionRate    Decimal @map("commission_rate") @db.Decimal(9, 8)
  hourlyRate        Decimal? @map("hourly_rate") @db.Decimal(20, 8)
  hours             Decimal? @db.Decimal(20, 8)
  calculationVersion String @default("income-v1") @map("calculation_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  source            IncomeSource @relation(fields: [sourceId, userId], references: [id, userId], onDelete: Cascade)
  account           Account @relation("IncomeAccount", fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  space             Space? @relation("IncomeSpace", fields: [spaceId, accountId, userId], references: [id, accountId, userId], onDelete: Restrict)
  @@unique([sourceId, version])
  @@index([userId, accountId])
  @@map("income_revisions")
}

model CommitmentSource {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  archivedFromMonth String? @map("archived_from_month") @db.Char(7)
  version           Int @default(1)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions         CommitmentRevision[]
  financing         Financing?
  investment        Investment?
  @@unique([id, userId])
  @@index([userId, id])
  @@map("commitment_sources")
}

model CommitmentRevision {
  id                String @id @default(uuid()) @db.Uuid
  sourceId          String @map("source_id") @db.Uuid
  userId            String @map("user_id") @db.Uuid
  version           Int
  name              String @db.VarChar(120)
  effectiveFromMonth String @map("effective_from_month") @db.Char(7)
  startsOn          DateTime @map("starts_on") @db.Date
  endsOn            DateTime? @map("ends_on") @db.Date
  accountId         String @map("account_id") @db.Uuid
  spaceId           String? @map("space_id") @db.Uuid
  input             Json
  amountCents       BigInt @map("amount_cents")
  calculationVersion String @default("commitment-v1") @map("calculation_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  source            CommitmentSource @relation(fields: [sourceId, userId], references: [id, userId], onDelete: Cascade)
  account           Account @relation("CommitmentAccount", fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  space             Space? @relation("CommitmentSpace", fields: [spaceId, accountId, userId], references: [id, accountId, userId], onDelete: Restrict)
  installments      CommitmentInstallment[]
  @@unique([sourceId, version])
  @@index([userId, accountId])
  @@map("commitment_revisions")
}

model CommitmentInstallment {
  revisionId String @map("revision_id") @db.Uuid
  ordinal    Int
  month      Int
  day        Int
  amountCents BigInt @map("amount_cents")
  revision   CommitmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  @@id([revisionId, ordinal])
  @@map("commitment_installments")
}

model FinancialEvent {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  entityType String @map("entity_type") @db.VarChar(32)
  entityId   String @map("entity_id") @db.Uuid
  action     String @db.VarChar(32)
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, entityType, entityId])
  @@map("financial_events")
}

model MonthlyPlan {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id") @db.Uuid
  month           String @db.Char(7)
  currentRevision Int @default(1) @map("current_revision")
  version         Int @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions       MonthlyPlanRevision[]
  @@unique([userId, month])
  @@unique([id, userId])
  @@map("monthly_plans")
}

model MonthlyPlanRevision {
  id                 String @id @default(uuid()) @db.Uuid
  planId             String @map("plan_id") @db.Uuid
  userId             String @map("user_id") @db.Uuid
  number             Int
  version            Int
  state              String @db.VarChar(8)
  snapshot           Json
  summary            Json
  expectedCashCents  BigInt @map("expected_cash_cents")
  taxReserveCents    BigInt @map("tax_reserve_cents")
  chargesCents       BigInt @map("charges_cents")
  availabilityCents  BigInt @map("availability_cents")
  allocatedCashCents BigInt @map("allocated_cash_cents")
  fundingGapCents    BigInt @map("funding_gap_cents")
  reopenReason      String? @map("reopen_reason") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  plan              MonthlyPlan @relation(fields: [planId, userId], references: [id, userId], onDelete: Cascade)
  @@unique([planId, number])
  @@index([userId, planId])
  @@map("monthly_plan_revisions")
}

model Financing {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @map("user_id") @db.Uuid
  planningSourceId String @unique @map("planning_source_id") @db.Uuid
  name             String @db.VarChar(120)
  lender           String? @db.VarChar(120)
  originalPrincipalCents BigInt? @map("original_principal_cents")
  version          Int @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planningSource   CommitmentSource @relation(fields: [planningSourceId, userId], references: [id, userId], onDelete: Restrict)
  balances         FinancingBalance[]
  @@unique([id, userId])
  @@unique([planningSourceId, userId])
  @@index([userId, name, id])
  @@map("financings")
}

model FinancingBalance {
  id          String @id @default(uuid()) @db.Uuid
  financingId String @map("financing_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  sequence    Int
  asOf        DateTime @map("as_of") @db.Date
  amountCents BigInt @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  financing   Financing @relation(fields: [financingId, userId], references: [id, userId], onDelete: Cascade)
  @@unique([financingId, sequence])
  @@index([userId, financingId, asOf])
  @@map("financing_balances")
}

model Investment {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @map("user_id") @db.Uuid
  planningSourceId String? @unique @map("planning_source_id") @db.Uuid
  name             String @db.VarChar(120)
  platform         String? @db.VarChar(120)
  ticker           String? @db.VarChar(30)
  kind             String @db.VarChar(16)
  mode             String @db.VarChar(16)
  version          Int @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planningSource   CommitmentSource? @relation(fields: [planningSourceId, userId], references: [id, userId], onDelete: Restrict)
  entries          InvestmentEntry[]
  valuations       InvestmentValuation[]
  @@unique([id, userId])
  @@unique([planningSourceId, userId])
  @@index([userId, name, id])
  @@map("investments")
}

model InvestmentEntry {
  id           String @id @default(uuid()) @db.Uuid
  investmentId String @map("investment_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  sequence     Int
  orderSequence Int @map("order_sequence")
  date         DateTime @db.Date
  kind         String @db.VarChar(16)
  quantity     Decimal? @db.Decimal(20, 8)
  amountCents  BigInt? @map("amount_cents")
  note         String? @db.VarChar(500)
  replacesId   String? @map("replaces_id") @db.Uuid
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason   String? @map("void_reason") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  investment   Investment @relation(fields: [investmentId, userId], references: [id, userId], onDelete: Cascade)
  @@unique([investmentId, sequence])
  @@index([userId, investmentId, date, sequence])
  @@map("investment_entries")
}

model InvestmentValuation {
  id           String @id @default(uuid()) @db.Uuid
  investmentId String @map("investment_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  sequence     Int
  asOf         DateTime @map("as_of") @db.Date
  amountCents  BigInt @map("amount_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  investment   Investment @relation(fields: [investmentId, userId], references: [id, userId], onDelete: Cascade)
  @@unique([investmentId, sequence])
  @@index([userId, investmentId, asOf])
  @@map("investment_valuations")
}
