{
  "name": "@personal-finance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm run --parallel '/^dev:/'",
    "dev:compile": "tsc -p tsconfig.build.json --watch",
    "dev:serve": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "openapi:export": "node dist/export-openapi.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "auth:reset-password": "node --env-file-if-exists=../../.env dist/modules/identity/cli.js reset-password",
    "auth:prune-sessions": "node --env-file-if-exists=../../.env dist/modules/identity/cli.js prune-sessions"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
